<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <!-- 留空表示「去仓库里找 parent」，而不是「去上级目录找 parent pom.xml」 -->
        <relativePath/>
    </parent>

    <groupId>com.hjh</groupId>
    <artifactId>tlias-backend</artifactId>
    <version>1.0.0</version>
    <name>tlias-backend</name>
    <description>tlias 智能学习辅助系统 - 后端</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 第三方库的版本号在这里集中定义，加依赖时引用 ${xxx.version}。
             只登记已经用 mvn dependency:get 实测存在的版本，不提前写猜测值。 -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <springdoc.version>2.8.17</springdoc.version>
        <!-- 0.12.x 线里最新的一个。0.13.0 也已发布，但本方案按文档锁定在 0.12.x -->
        <jjwt.version>0.12.7</jjwt.version>
        <easyexcel.version>3.3.4</easyexcel.version>
        <aliyun-oss.version>3.18.5</aliyun-oss.version>
        <!-- P8：1.1.8 是 mvn dependency:get 实测存在的版本（阿里云镜像可拉取） -->
        <spring-ai.version>1.1.8</spring-ai.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：@NotNull / @NotBlank / @Size 等注解 + @Valid 触发校验。
             它本来是跟着 springdoc 传递进来的，能蹭到不代表可以依赖它——
             哪天 springdoc 换版本不再传递，校验注解会「编译通过但运行期不生效」。
             所以显式声明一次：我确实需要它。版本由 parent 托管 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP 支持（P7 操作日志切面）。版本由 parent 托管。
             这个 starter 连带引入 aspectjweaver（织入切面的运行时），
             没有它 @Aspect 类会被静默忽略——切面「不存在又不报错」是最难排查的一类问题 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 持久层。这个 starter 会连带引入 spring-boot-starter-jdbc 和 HikariCP 连接池 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- 必须单独引，且版本与上面的 starter 完全一致。
             3.5.9 起 MyBatis-Plus 把 jsqlparser 从核心包里解耦了出去，
             漏引的后果是启动时报 NoClassDefFoundError: PaginationInnerInterceptor -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动。版本由 spring-boot-starter-parent 托管，所以不写 <version>。
             坐标是 com.mysql:mysql-connector-j，
             不是旧的 mysql:mysql-connector-java（那个已废弃） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 根据代码自动生成 OpenAPI 文档，并附带一个 Swagger UI 网页，
             可以直接在浏览器里点着调接口，不用手写 curl -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- JWT 三件套：api 是编译期依赖，impl 和 jackson 只在运行期需要。
             api 的 scope 保持默认（compile），另两个标 runtime —— 这样业务代码
             只能看到接口，看不到实现，从依赖层面就阻止了误用内部类 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 只要 BCrypt 密码加密，不要整个 Spring Security。
             这个包是独立可用的，不会引入过滤器链、也不会自动开启安全拦截。
             版本由 spring-boot-starter-parent 托管的 spring-security-bom 提供（6.5.11） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Excel 导出。EasyExcel 是阿里出的，用法比裸写 POI 简单得多：
             给 VO 字段标 @ExcelProperty("姓名") 就完事，不用自己建 sheet、建行、建单元格。

             关于它的 POI 依赖：实测 easyexcel-core:3.3.4 自带的是
               poi / poi-ooxml / poi-ooxml-schemas 全部 4.1.2
            三者版本完全一致。计划书里担心的「POI 版本打架导致 NoSuchMethodError」
             成立的前提是项目里还有别的库也在引 POI（版本不同才会打架），
             本项目没有第二个引 POI 的库，所以这里不需要额外做版本对齐。

             注：EasyExcel 的最后一版是 3.3.4，之后项目改名成 FastExcel 另起炉灶；
             4.0.3 是另一条线（用 POI 5.2.5）。本方案按计划书锁 3.3.4 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>${easyexcel.version}</version>
        </dependency>

        <!-- 本地缓存库。CacheService 的默认实现就建在它上面，
             用来存「放几秒到几十分钟」的小数据（验证码、图形验证码答案这类）。
             版本由 spring-boot-starter-parent 托管，不写 <version> -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Redis 客户端（底层是 Lettuce）。这里只是把「将来要用」的依赖和实现类备好：
             默认 profile（dev）下 CacheService 装配的是 Caffeine 实现，
             这个 starter 虽然会把 RedisTemplate 等 bean 备好，但第一次真正用之前
             不会和任何 Redis 服务器建连接，所以本地不装 Redis 也不会启动失败。
             等部署了 Redis，启动时把激活 profile 换成 redis 才会切到 Redis 实现 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 阿里云 OSS 对象存储 SDK（V1 版，阿里官方文档的主线）。
             用途：FileStorageService 的第二个实现——头像等文件传到 OSS 后拿公网 URL。
             默认 profile（dev）下不会被启用，走本地磁盘实现；
             要真连 OSS 时把激活 profile 换成 dev,oss 切换。
             3.18.5 是 dependency:get 实测存在的版本。
             另外实测过它的 class 文件不引用 javax.xml.bind / javax.activation，
             所以 JDK 9+ 从内置模块里移走 JAXB 这件事不影响它，无需补依赖 -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>${aliyun-oss.version}</version>
        </dependency>

        <!-- Spring AI（P8 AI 增强）。用途：AiChatService 的第二个实现
             （DeepSeekAiChatServiceImpl）——DeepSeek 提供 OpenAI 兼容协议，
             所以用 OpenAI 的 starter，把 base-url 指过去即可。

             这个 starter 会带来 chat / embedding / image / audio / moderation
             一整套自动配置，且「默认全开」；没配 api-key 时它们的 bean 创建会失败，
             导致应用起不来。所以默认 profile 里用 spring.ai.model.*=none 全部关掉
             （见 application.yml），激活 deepseek profile 才打开（application-deepseek.yml） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Lombok 只在编译期生成 getter/setter，运行期不需要它，
                             打进 jar 是纯粹的体积浪费 -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
