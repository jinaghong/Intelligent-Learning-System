<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <!-- 留空表示「去仓库里找 parent」，而不是「去上级目录找 parent pom.xml」 -->
        <relativePath/>
    </parent>

    <groupId>com.hjh</groupId>
    <artifactId>tlias-backend</artifactId>
    <version>1.0.0</version>
    <name>tlias-backend</name>
    <description>tlias 智能学习辅助系统 - 后端</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 第三方库的版本号在这里集中定义，加依赖时引用 ${xxx.version}。
             只登记已经用 mvn dependency:get 实测存在的版本，不提前写猜测值。 -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <springdoc.version>2.8.17</springdoc.version>
        <!-- 0.12.x 线里最新的一个。0.13.0 也已发布，但本方案按文档锁定在 0.12.x -->
        <jjwt.version>0.12.7</jjwt.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 持久层。这个 starter 会连带引入 spring-boot-starter-jdbc 和 HikariCP 连接池 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- 必须单独引，且版本与上面的 starter 完全一致。
             3.5.9 起 MyBatis-Plus 把 jsqlparser 从核心包里解耦了出去，
             漏引的后果是启动时报 NoClassDefFoundError: PaginationInnerInterceptor -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动。版本由 spring-boot-starter-parent 托管，所以不写 <version>。
             坐标是 com.mysql:mysql-connector-j，
             不是旧的 mysql:mysql-connector-java（那个已废弃） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 根据代码自动生成 OpenAPI 文档，并附带一个 Swagger UI 网页，
             可以直接在浏览器里点着调接口，不用手写 curl -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- JWT 三件套：api 是编译期依赖，impl 和 jackson 只在运行期需要。
             api 的 scope 保持默认（compile），另两个标 runtime —— 这样业务代码
             只能看到接口，看不到实现，从依赖层面就阻止了误用内部类 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 只要 BCrypt 密码加密，不要整个 Spring Security。
             这个包是独立可用的，不会引入过滤器链、也不会自动开启安全拦截。
             版本由 spring-boot-starter-parent 托管的 spring-security-bom 提供（6.5.11） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Lombok 只在编译期生成 getter/setter，运行期不需要它，
                             打进 jar 是纯粹的体积浪费 -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
