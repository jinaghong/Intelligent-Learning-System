# ============================================================
#  模板文件（本文件会提交到 git，作用是让别人知道要填哪些键）
#
#  用法：复制一份，改名为 application-local.yml，再填入真实值。
#  application-local.yml 已被 .gitignore 排除，永远不会进 git。
#
#  另一条路：不改文件，直接设操作系统环境变量（DB_PASSWORD /
#  DEEPSEEK_API_KEY 等），环境变量优先级最高，会覆盖这里的值。
# ============================================================

spring:
  datasource:
    # P1 接入 MyBatis-Plus 后开始生效。填 MySQL 的 root 密码。
    password: "填你的MySQL密码"

  ai:
    openai:
      # P8 阶段（AI 增强）才需要。填 DeepSeek 平台申请的 sk- 开头密钥——
      # DeepSeek 提供 OpenAI 兼容协议，所以键挂名在 openai 下（base-url 已在
      # application-deepseek.yml 里指到 api.deepseek.com）。
      # 也可以不写这里，改设环境变量 DEEPSEEK_API_KEY（优先级更高）。
      # 注意：真调用还要激活 deepseek profile（--spring.profiles.active=dev,deepseek）；
      # 不激活时走 Mock 实现，接口照常能调、不产生费用、也不用填这个 key。
      api-key: "填sk开头的密钥"

aliyun:
  oss:
    # 待 bucket 开通后再填。在此之前项目走 LocalFileStorageServiceImpl，
    # 图片存在本地 uploads/ 目录，不需要任何阿里云凭据。
    access-key-id: ""
    access-key-secret: ""
    bucket-name: ""
    endpoint: ""
